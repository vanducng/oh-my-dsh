{
  "name": "oh-my-dsh",
  "private": true,
  "description": "omdsh: a TUI coding agent on the DeepSeek Harness core runtime",
  "version": "0.9.0",
  "license": "MIT",
  "author": "Duc Nguyen <me@vanducng.dev>",
  "homepage": "https://github.com/vanducng/oh-my-dsh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanducng/oh-my-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/vanducng/oh-my-dsh/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r build",
    "benchmark:tui": "tsx scripts/benchmark-tui.mts",
    "test": "node --test scripts/format-markdown.spec.mjs scripts/tui-grid.spec.mjs && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format:md": "node scripts/format-markdown.mjs && node scripts/sync-package-readme.mjs",
    "check:md": "node scripts/format-markdown.mjs --check && node scripts/sync-package-readme.mjs --check",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "sync:package-readme": "node scripts/sync-package-readme.mjs",
    "omdsh": "pnpm --dir apps/omdsh omdsh",
    "smoke": "node scripts/pty-smoke.mjs",
    "smoke:happy": "node scripts/happy-smoke.mjs",
    "smoke:tui": "node scripts/tui-grid-smoke.mjs",
    "test:package": "pnpm build && node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@deepseek-ai/dsh-llm-mock-server": "0.1.1-rc.2",
    "@types/node": "^22.10.0",
    "@xterm/headless": "6.0.0",
    "lefthook": "2.1.10",
    "node-pty": "^1.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
